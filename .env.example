# ---------------------------------------------------------------------------
# ReplyMate Control — environment template
#
# Copy to `.env` and fill in. `.env` is gitignored and MUST stay that way.
# Nothing in this file is a real credential, and no code path prints one.
# ---------------------------------------------------------------------------

# --- Control plane database (required) -------------------------------------
# Local development: the sandbox Postgres.
# Production: a Supabase Postgres connection string works unchanged — Drizzle
# speaks the wire protocol, so the same schema applies. This platform NEVER
# points at the ReplyMate production database.
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- Encryption for the TOTP shared secret (required for MFA enrolment) ------
# Minimum 32 characters. Used to derive an AES-256-GCM key. If it is absent,
# MFA enrolment is REFUSED rather than storing a factor in plaintext.
# Changing it after enrolment invalidates existing factors (they cannot be
# decrypted) — an owner must reset MFA for affected accounts.
CONTROL_ENC_KEY=

# --- Sessions ---------------------------------------------------------------
SESSION_COOKIE_NAME=rmctl_session
SESSION_TTL_HOURS=8

# --- First-owner bootstrap (used only by scripts/bootstrap.ts) ---------------
# Never accepted over HTTP. Leave blank in a committed file.
BOOTSTRAP_OWNER_EMAIL=
BOOTSTRAP_OWNER_PASSWORD=

# --- Administrator identity --------------------------------------------------
# `local`    = credentials live in the control-plane database (default).
# `supabase` = Supabase Auth is the identity provider for administrators.
AUTH_PROVIDER=local

# --- Supabase bridge to the ReplyMate cloud foundation (optional) ------------
# The ReplyMate project URL is public by design: the database is guarded by RLS,
# not by key secrecy (docs/supabase/README.md).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key. Grants full access — keep it server-side, rotate it if it is
# ever exposed, and never add it to a client bundle, a log or a commit.
SUPABASE_SERVICE_ROLE_KEY=
# Optional direct/pooler connection, if you want SQL-level verification.
SUPABASE_DB_URL=

# --- AI operations assistant (optional) --------------------------------------
# Leave AIOPS_PROVIDER=none to run the deterministic runbook engine, which
# executes real tools against the control plane and never guesses.
AIOPS_PROVIDER=none
AIOPS_API_KEY=
AIOPS_MODEL=
AIOPS_BASE_URL=

# --- Read-only integration with the ReplyMate source repository --------------
# The repository is public, so a token is optional. GET requests only: this
# platform never pushes to, mutates, builds or deploys the Android app.
REPLYMATE_REPO=spencerbby8-gif/ReplyMate
GITHUB_READ_TOKEN=
